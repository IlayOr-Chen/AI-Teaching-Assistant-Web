# ====================================================================
# Web-Based AI Teaching Assistant — Environment Configuration Template
# Copy this file to `.env` and fill in your credentials before running.
# NEVER commit `.env` or `serviceAccountKey.json` to Git.
# ====================================================================

# Firebase Realtime Database Configuration
FIREBASE_DB_URL=https://ai-teaching-assistant-web-default-rtdb.firebaseio.com/
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
USE_MOCK_FIREBASE=false

# Authentication & Security Secrets
JWT_SECRET=replace-with-a-strong-random-32-byte-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=12
LECTURER_ACCESS_CODE=TA-ADMIN-2026

# Smart Attendance & Device Cooldown Configuration
QR_ROTATION_SECONDS=12
DEVICE_COOLDOWN_MINUTES=15
ENFORCE_SAME_NETWORK_DEFAULT=true

# Google Gemini AI Configuration (Video Summary & Homework Review)
GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash-lite

# Local YOLO Classroom Headcount Configuration
YOLO_MODEL_PATH=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.30
